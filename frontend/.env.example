# EmailJS Configuration (https://www.emailjs.com/)
# 1. Sign up / Log in to EmailJS.
# 2. Add Email Service (e.g. Gmail connected to patelsamerth9@gmail.com) -> Copy Service ID
# 3. Create an Email Template:
#    - "To Email": patelsamerth9@gmail.com
#    - "Reply-To": {{reply_to}}
#    - "Subject": {{subject}}
#    - Content: {{message}} from {{from_name}} ({{from_email}}) at {{submission_time}}
#    -> Copy Template ID
# 4. In Account Settings > API Keys -> Copy Public Key
# 5. Place these values in frontend/.env

VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
